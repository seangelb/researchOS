{
  "name": "ResearchOS",
  "install": "bash scripts/install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && . .venv/bin/activate && uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"
    },
    {
      "name": "frontend",
      "command": "cd frontend && npm run dev -- --host 0.0.0.0 --port 5173"
    }
  ],
  "ports": [
    { "name": "API", "port": 8000 },
    { "name": "Web", "port": 5173 }
  ]
}
